    {
      "name": "a full-screen program that turns off the alternate scroll and turns on the mouse reports 1000, 1002 and 1003 with SGR receives SGR wheel buttons",
      "output": "\u001b[?1049h\u001b[?1007l\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h",
      "modes": {
        "mouseClick": false,
        "mouseDrag": false,
        "mouseMotion": true,
        "sgrMouse": true,
        "alternateScroll": false,
        "altScreen": true,
        "appCursor": false
      },
      "scrolls": [
        {
          "lines": 2,
          "col": 4,
          "row": 6,
          "shift": false,
          "route": "program",
          "write": "\u001b[<64;5;7M\u001b[<64;5;7M"
        },
        {
          "lines": -1,
          "col": 4,
          "row": 6,
          "shift": false,
          "route": "program",
          "write": "\u001b[<65;5;7M"
        },
        {
          "lines": 2,
          "col": 4,
          "row": 6,
          "shift": true,
          "route": "viewport",
          "write": null
        }
      ]
    },
    {
