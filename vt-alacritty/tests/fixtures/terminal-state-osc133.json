{
  "contract": "docs/spec/terminal-state.md",
  "cases": [
    {
      "name": "a prompt, a command and its exit code",
      "output": "\u001b]133;A\u0007$ \u001b]133;B\u0007\u001b]133;C\u0007done\r\n\u001b]133;D;0\u0007\u001b]133;A\u0007",
      "rejected": false,
      "events": [
        {"from": null, "to": "idle", "source": "osc133", "sequence": 1, "exit": null},
        {"from": "idle", "to": "running", "source": "osc133", "sequence": 2, "exit": null},
        {"from": "running", "to": "exited", "source": "osc133", "sequence": 3, "exit": 0},
        {"from": "exited", "to": "idle", "source": "osc133", "sequence": 4, "exit": 0}
      ],
      "read": {"state": "idle", "source": "osc133", "sequence": 4, "exit": 0}
    },
    {
      "name": "a failed command keeps its exit code at the next prompt until the next command",
      "output": "\u001b]133;C\u001b\\\u001b]133;D;127\u001b\\\u001b]133;A\u001b\\",
      "rejected": false,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null},
        {"from": "running", "to": "exited", "source": "osc133", "sequence": 2, "exit": 127},
        {"from": "exited", "to": "idle", "source": "osc133", "sequence": 3, "exit": 127}
      ],
      "read": {"state": "idle", "source": "osc133", "sequence": 3, "exit": 127}
    },
    {
      "name": "a finished mark without an exit code",
      "output": "\u001b]133;C\u0007\u001b]133;D\u0007",
      "rejected": false,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null},
        {"from": "running", "to": "exited", "source": "osc133", "sequence": 2, "exit": null}
      ],
      "read": {"state": "exited", "source": "osc133", "sequence": 2, "exit": null}
    },
    {
      "name": "a finished mark with only a named parameter",
      "output": "\u001b]133;C\u0007\u001b]133;D;aid=7\u0007",
      "rejected": false,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null},
        {"from": "running", "to": "exited", "source": "osc133", "sequence": 2, "exit": null}
      ],
      "read": {"state": "exited", "source": "osc133", "sequence": 2, "exit": null}
    },
    {
      "name": "a repeated mark gives no change",
      "output": "\u001b]133;A\u0007\u001b]133;B\u0007\u001b]133;A;redraw=last\u0007",
      "rejected": false,
      "events": [
        {"from": null, "to": "idle", "source": "osc133", "sequence": 1, "exit": null}
      ],
      "read": {"state": "idle", "source": "osc133", "sequence": 1, "exit": null}
    },
    {
      "name": "an explicit prompt start of a continuation line gives idle",
      "output": "\u001b]133;C\u0007\u001b]133;D;0\u0007\u001b]133;P;k=s\u0007",
      "rejected": false,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null},
        {"from": "running", "to": "exited", "source": "osc133", "sequence": 2, "exit": 0},
        {"from": "exited", "to": "idle", "source": "osc133", "sequence": 3, "exit": 0}
      ],
      "read": {"state": "idle", "source": "osc133", "sequence": 3, "exit": 0}
    },
    {
      "name": "a prompt kind that is not defined is a malformed mark",
      "output": "\u001b]133;C\u0007\u001b]133;P;k=x\u0007",
      "rejected": true,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null}
      ],
      "read": {"state": "running", "source": "osc133", "sequence": 1, "exit": null}
    },
    {
      "name": "output without a mark has no state",
      "output": "plain output\r\n",
      "rejected": false,
      "events": [],
      "read": {"state": null, "source": null, "sequence": 0, "exit": null}
    },
    {
      "name": "an exit code that is not a number is a malformed mark",
      "output": "\u001b]133;C\u0007\u001b]133;D;x\u0007",
      "rejected": true,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null}
      ],
      "read": {"state": "running", "source": "osc133", "sequence": 1, "exit": null}
    },
    {
      "name": "an exit code above 255 is a malformed mark",
      "output": "\u001b]133;C\u0007\u001b]133;D;256\u0007",
      "rejected": true,
      "events": [
        {"from": null, "to": "running", "source": "osc133", "sequence": 1, "exit": null}
      ],
      "read": {"state": "running", "source": "osc133", "sequence": 1, "exit": null}
    }
  ]
}
